# ---------------------------------------------------------------------------
# Настройки сборки сайта Вологда Брус.
#
# Скопировать в `.env` и заполнить. Файл `.env` в репозиторий не попадает
# (см. .gitignore) — номера счётчиков и адрес приёмника заявок живут только
# на том сервере, где собирается сайт.
#
# Пустое значение = возможность выключена. Сайт при этом работает полностью,
# просто не считает посещения и не принимает заявки.
# ---------------------------------------------------------------------------

# --- Приём заявок ----------------------------------------------------------
# Адрес, куда уходит POST с полями формы. Это может быть свой обработчик,
# Formspree или бот в Telegram. Пока пусто — формы честно отвечают
# «Приём заявок пока не настроен», а не теряют заявки молча.
NUXT_PUBLIC_FORM_ENDPOINT=

# --- Яндекс.Метрика --------------------------------------------------------
# Номер счётчика, только цифры. Счётчик нужен новый: переносимый сайт
# (вологдабрус.рф) аналитики не имел вовсе, наследовать нечего.
# Где взять: metrika.yandex.ru → создать счётчик → Настройка → «Номер счётчика».
# Не путать со счётчиком 107226117 — он собирал данные прежнего сайта на
# Рег.ру, который заменён 23.10.2026. Это другой сайт, и смешивать его
# статистику с новой не стоит.
NUXT_PUBLIC_METRIKA_ID=

# --- Google Analytics 4 ----------------------------------------------------
# Идентификатор потока данных, вида G-XXXXXXXXXX.
# Где взять: analytics.google.com → Администратор → Потоки данных →
# выбрать поток → «Идентификатор потока данных».
NUXT_PUBLIC_GA_ID=

# --- Подтверждение прав на сайт --------------------------------------------
# Только содержимое тега, без обёртки <meta>. Нужно один раз, чтобы Вебмастер
# и Search Console пустили к отчётам и приняли карту сайта.
#
# Яндекс.Вебмастер: webmaster.yandex.ru → добавить сайт → способ «Мета-тег» →
# скопировать значение content="…"
NUXT_PUBLIC_YANDEX_VERIFICATION=

# Google Search Console: search.google.com/search-console → добавить ресурс
# «Префикс URL» → способ «Тег HTML» → скопировать значение content="…"
NUXT_PUBLIC_GOOGLE_VERIFICATION=
